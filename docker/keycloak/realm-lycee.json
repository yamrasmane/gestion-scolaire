{
  "realm": "lycee",
  "displayName": "Gestion scolaire",
  "enabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(8) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrateur : accès à toutes les fonctions de l'application"
      },
      {
        "name": "DIRECTEUR",
        "description": "Chef d'établissement"
      },
      {
        "name": "CENSEUR",
        "description": "Censeur"
      },
      {
        "name": "ENSEIGNANT",
        "description": "Enseignant"
      },
      {
        "name": "INTENDANT",
        "description": "Intendant : paramétrage financier"
      },
      {
        "name": "ECONOME",
        "description": "Économe / caissier : encaissements"
      },
      {
        "name": "SURVEILLANT",
        "description": "Surveillant"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lycee-frontend",
      "name": "Interface Angular",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "lycee-backend",
      "name": "API Spring Boot (provisionnement des comptes)",
      "enabled": true,
      "publicClient": false,
      "secret": "changez-ce-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Administrateur",
      "lastName": "Lycée",
